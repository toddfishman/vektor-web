# Copy to .env.local for development. In production set these in the host (Vercel/Netlify).

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://vektor-logistics.com
# 1 = noindex everything (use on staging/preview)
NEXT_PUBLIC_NOINDEX=1
# 1 = hide the "draft placeholder" banner on legal pages (only once counsel's text is in)
NEXT_PUBLIC_LEGAL_FINAL=

# --- Leads (forms) ---
# At least one channel is required in production or forms return 503 instead of dropping leads.
# Email via Resend (verify the sending domain in Resend first)
RESEND_API_KEY=
LEADS_FROM="Vektor Website <web@vektor-logistics.com>"
# Comma-separated recipients per form; LEADS_TO_DEFAULT is the fallback
LEADS_TO_DEFAULT=sales@vektor-logistics.com
LEADS_TO_QUOTE=
LEADS_TO_CONTACT=
LEADS_TO_CARRIER=
LEADS_TO_CAREERS=
LEADS_TO_PARTNERSHIP=
LEADS_TO_REFERRAL=
# Webhook: CRM / Power Automate / Zapier. Body is the Lead JSON (incl. Turvo-mapped quote);
# header x-vektor-signature = HMAC-SHA256(body, LEADS_WEBHOOK_SECRET) hex
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_SECRET=

# --- Employee area: Microsoft 365 SSO (docs/m365-sso.md) ---
# openssl rand -base64 33
AUTH_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=

# --- Website AI agent (/contact chat) ---
# Anthropic API key (console.anthropic.com). Without it the chat shows "offline" and points to the phone line.
ANTHROPIC_API_KEY=
# Optional overrides
AGENT_MODEL=claude-sonnet-5-5
# 0 = switch the agent off without removing the key
AGENT_ENABLED=

# --- Employee portal preview ---
# Preview mode is automatic on noindex drafts while SSO is not configured. TEAM_DEMO=1 forces it
# (still only while SSO is not configured). Never needed in production.
TEAM_DEMO=
